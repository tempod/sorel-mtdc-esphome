# Copia questo file in "secrets.yaml" (nella stessa cartella della configurazione
# ESPHome) e inserisci i tuoi valori. secrets.yaml e' escluso da git (.gitignore).

wifi_ssid: "NomeReteWiFi"
wifi_password: "PasswordWiFi"
wifi_password_fallback: "PasswordAccessPointDiEmergenza"

# Chiave API cifrata: generala con "esphome wizard" oppure da
# https://esphome.io/components/api.html (32 byte in base64)
api_key_sorelmtdc: "INSERISCI_QUI_LA_CHIAVE_BASE64="

# IP statico del dispositivo
ip_sorelmtdc: 192.168.1.50
network_gateway: 192.168.1.1
network_subnet: 255.255.255.0
